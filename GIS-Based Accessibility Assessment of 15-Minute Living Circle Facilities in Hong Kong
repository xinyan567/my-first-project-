import geopandas as gpd
import pandas as pd
import numpy as np
from shapely.geometry import Point
import matplotlib.pyplot as plt
import matplotlib
import warnings
import matplotlib.font_manager as fm
warnings.filterwarnings('ignore')

# ========== 中文字体配置 ==========
# 1. 尝试查找系统中是否存在常用中文字体
def get_chinese_font():
    font_list = fm.findSystemFonts(fontpaths=None, fontext='ttf')
    # 常用中文字体文件名关键词
    chinese_fonts_keywords = ['SimHei', 'Microsoft YaHei', 'Heiti', 'STHeiti', 'Noto Sans CJK', 'PingFang', 'WenQuanYi']
    
    for font_path in font_list:
        font_name = fm.FontProperties(fname=font_path).get_name()
        if any(keyword.lower() in font_name.lower() for keyword in chinese_fonts_keywords):
            return font_name
            
    # 如果找不到特定字体，返回通用 sans-serif 
    return 'sans-serif'

system_font = get_chinese_font()

# 2. 全局配置
plt.rcParams['font.family'] = 'sans-serif'
plt.rcParams['font.sans-serif'] = [system_font, 'SimHei', 'Microsoft YaHei', 'Arial', 'DejaVu Sans']
plt.rcParams['axes.unicode_minus'] = False  # 解决负号 '-' 显示为方块的问题
plt.rcParams['font.size'] = 10

print(f"✓ 字体配置完成，当前使用字体: {system_font} (若此字体为sans-serif，请注意保存为图片后检查是否乱码)")
# ==================================================


# --- 1. 配置路径 ---
DATA_PATH = "./data"
boundary_geojson = f"{DATA_PATH}/boundary.geojson"
population_csv = f"{DATA_PATH}/boundary.CSV"
bus_file = f"{DATA_PATH}/bus.geojson"
park_file = f"{DATA_PATH}/parks.geojson"
hospital_file = f"{DATA_PATH}/hospitals.geojson"

# --- 2. 加载数据 ---
print("=" * 60)
print("开始加载数据...")
print("=" * 60)

# 2.1 加载边界地理数据 (GeoJSON)
try:
    boundary_gdf = gpd.read_file(boundary_geojson)
    print(f"✓ 边界地理数据加载成功: {len(boundary_gdf)} 个区域")
except Exception as e:
    print(f"✗ 加载边界地理数据失败: {e}")
    exit()

# 2.2 加载人口统计数据 (CSV)
try:
    population_df = pd.read_csv(population_csv, skiprows=3, encoding='utf-8-sig')
    population_df.columns = population_df.columns.str.strip()
    print(f"✓ 人口统计数据加载成功: {len(population_df)} 条记录")
    print(f"  列数: {len(population_df.columns)}")
    
    key_cols = ['dcca_chi', 'dcca', 'dc_chi', 't_pop', 'pop_m', 'pop_f']
    available_key_cols = [col for col in key_cols if col in population_df.columns]
    print(f"  可用关键列: {available_key_cols}")
except Exception as e:
    print(f"✗ 加载人口统计数据失败: {e}")
    population_df = pd.DataFrame()

# 2.3 加载设施数据
try:
    bus_stops = gpd.read_file(bus_file)
    print(f"✓ 巴士站数据加载成功: {len(bus_stops)} 个站点")
except Exception as e:
    print(f"✗ 加载巴士站数据失败: {e}")
    bus_stops = gpd.GeoDataFrame()

try:
    parks = gpd.read_file(park_file)
    print(f"✓ 公园数据加载成功: {len(parks)} 个公园")
except Exception as e:
    print(f"✗ 加载公园数据失败: {e}")
    parks = gpd.GeoDataFrame()

try:
    hospitals = gpd.read_file(hospital_file)
    print(f"✓ 医院数据加载成功: {len(hospitals)} 个医院/诊所")
except Exception as e:
    print(f"✗ 加载医院数据失败: {e}")
    hospitals = gpd.GeoDataFrame()

# --- 3. 数据整合与预处理 ---
print("\n" + "=" * 60)
print("开始数据整合与预处理...")
print("=" * 60)

# 3.1 统一坐标系为 WGS 84
boundary_gdf = boundary_gdf.to_crs("EPSG:4326")
if not bus_stops.empty:
    bus_stops = bus_stops.to_crs("EPSG:4326")
if not parks.empty:
    parks = parks.to_crs("EPSG:4326")
if not hospitals.empty:
    hospitals = hospitals.to_crs("EPSG:4326")

# 3.2 合并人口数据到边界数据
boundary_cols = boundary_gdf.columns.tolist()
pop_cols = population_df.columns.tolist() if not population_df.empty else []

print(f"\n边界数据列名示例: {boundary_cols[:5]}")
print(f"人口数据列名示例: {pop_cols[:5]}")

merge_key = None
hk_name_variants = ['dcca_chi', 'dcca_eng', 'dc_chi', 'ca_chi', 'dcca']
for col in hk_name_variants:
    if col in boundary_cols and col in pop_cols:
        merge_key = col
        print(f"  找到匹配列: '{col}'")
        break

if merge_key is None:
    name_variants = ['region_name', 'district', 'area_name', 'name']
    for col in name_variants:
        if col in boundary_cols and col in pop_cols:
            merge_key = col
            print(f"  找到匹配列: '{col}'")
            break

if merge_key is not None:
    boundary_gdf[merge_key] = boundary_gdf[merge_key].astype(str).str.strip()
    population_df[merge_key] = population_df[merge_key].astype(str).str.strip()
    
    boundary_gdf = boundary_gdf.merge(population_df, on=merge_key, how='left')
    print(f"✓ 人口数据已通过 '{merge_key}' 列合并")
    
    if 't_pop' in boundary_gdf.columns:
        missing_count = boundary_gdf['t_pop'].isna().sum()
        matched_count = len(boundary_gdf) - missing_count
        print(f"  成功匹配: {matched_count}/{len(boundary_gdf)} 个区域")
        if missing_count > 0:
            print(f"  ⚠ 缺失人口数据的区域: {missing_count} 个")
            median_pop = boundary_gdf['t_pop'].median()
            boundary_gdf['t_pop'] = boundary_gdf['t_pop'].fillna(median_pop)
            print(f"  已使用中位数 {median_pop:.0f} 填充缺失值")
else:
    print("⚠ 警告: 无法找到匹配列进行合并")
    boundary_gdf['t_pop'] = 10000
    boundary_gdf['pop_m'] = 5000
    boundary_gdf['pop_f'] = 5000
    print("  已添加默认人口数据 (10000)")

# 3.3 检查人口相关字段
pop_related_cols = [col for col in boundary_gdf.columns if 'pop' in col.lower() or '人口' in col or 'elder' in col.lower() or '老年' in col]
print(f"  找到的人口相关字段: {pop_related_cols[:5]}")

# 3.4 标准化设施数据
def prepare_facilities(gdf, facility_type):
    if gdf.empty:
        return gdf
    gdf['facility_type'] = facility_type
    if 'name' not in gdf.columns:
        name_variants = ['Name', 'NAME', 'facility_name', 'stop_name', 'park_name', 'hospital_name']
        for col in name_variants:
            if col in gdf.columns:
                gdf['name'] = gdf[col]
                break
        if 'name' not in gdf.columns:
            gdf['name'] = gdf.index.astype(str)
    if 'service_time' not in gdf.columns:
        time_variants = ['service_hours', 'opening_hours']
        for col in time_variants:
            if col in gdf.columns:
                gdf['service_time'] = gdf[col]
                break
        if 'service_time' not in gdf.columns:
            gdf['service_time'] = '未知'
    return gdf

bus_stops = prepare_facilities(bus_stops, 'bus_stop')
parks = prepare_facilities(parks, 'park')
hospitals = prepare_facilities(hospitals, 'hospital')

# 3.5 合并所有设施
all_facilities_list = []
for gdf in [bus_stops, parks, hospitals]:
    if not gdf.empty:
        gdf['longitude'] = gdf.geometry.x
        gdf['latitude'] = gdf.geometry.y
        required_cols = ['name', 'facility_type', 'longitude', 'latitude', 'service_time', 'geometry']
        available_cols = [col for col in required_cols if col in gdf.columns]
        all_facilities_list.append(gdf[available_cols])

if all_facilities_list:
    all_facilities = pd.concat(all_facilities_list, ignore_index=True)
    facilities_gdf = gpd.GeoDataFrame(all_facilities, geometry='geometry', crs="EPSG:4326")
    print(f"✓ 所有设施合并完成: 共 {len(facilities_gdf)} 个设施")
    print(f"  巴士站: {len(facilities_gdf[facilities_gdf['facility_type']=='bus_stop'])}")
    print(f"  公园: {len(facilities_gdf[facilities_gdf['facility_type']=='park'])}")
    print(f"  医院: {len(facilities_gdf[facilities_gdf['facility_type']=='hospital'])}")
else:
    print("✗ 没有加载到任何设施数据")
    facilities_gdf = gpd.GeoDataFrame()

# --- 4. 核心分析 ---
print("\n" + "=" * 60)
print("开始15分钟生活圈覆盖分析...")
print("=" * 60)

boundary_proj = boundary_gdf.to_crs("EPSG:2326")
if not facilities_gdf.empty:
    facilities_proj = facilities_gdf.to_crs("EPSG:2326")

WALK_DISTANCE = 1250

coverage_results = []
print(f"正在分析 {len(boundary_proj)} 个区域...")

for idx, region in boundary_proj.iterrows():
    region_name = None
    for name_col in ['dcca_chi', 'dcca_eng', 'dc_chi', 'ca_chi', 'region_name', 'name']:
        if name_col in region.index and pd.notna(region.get(name_col)):
            region_name = region.get(name_col)
            break
    if region_name is None:
        region_name = f'区域_{idx}'
    
    region_geom = region.geometry
    region_buffer = region_geom.buffer(WALK_DISTANCE)
    
    if not facilities_proj.empty:
        facilities_in_buffer = facilities_proj[facilities_proj.intersects(region_buffer)]
        bus_count = len(facilities_in_buffer[facilities_in_buffer['facility_type'] == 'bus_stop'])
        park_count = len(facilities_in_buffer[facilities_in_buffer['facility_type'] == 'park'])
        hospital_count = len(facilities_in_buffer[facilities_in_buffer['facility_type'] == 'hospital'])
        total_facilities = len(facilities_in_buffer)
        facility_names = facilities_in_buffer['name'].tolist()[:10]
    else:
        bus_count = park_count = hospital_count = total_facilities = 0
        facility_names = []
    
    total_pop = region.get('t_pop', np.nan) if 't_pop' in region.index else np.nan
    
    coverage_results.append({
        'region_name': region_name,
        'total_population': total_pop,
        'bus_stops': bus_count,
        'parks': park_count,
        'hospitals': hospital_count,
        'total_facilities': total_facilities,
        'facility_names_sample': '; '.join(facility_names) if facility_names else '无'
    })

coverage_df = pd.DataFrame(coverage_results)
print(f"✓ 覆盖分析完成")

# 4.4 计算覆盖率指标
if 'total_population' in coverage_df.columns:
    missing_pop = coverage_df['total_population'].isna().sum()
    if missing_pop > 0:
        print(f"⚠ {missing_pop} 个区域缺少人口数据，使用中位数填充")
        coverage_df['total_population'] = coverage_df['total_population'].fillna(
            coverage_df['total_population'].median()
        )
    
    coverage_df['facilities_per_1000'] = coverage_df['total_facilities'] / (coverage_df['total_population'] / 1000)
    coverage_df['facilities_per_1000'] = coverage_df['facilities_per_1000'].round(2)
    coverage_df['facilities_per_1000'] = coverage_df['facilities_per_1000'].replace([np.inf, -np.inf], 0)

# --- 5. 分析结果展示 ---
print("\n" + "=" * 60)
print("分析结果概览")
print("=" * 60)

print("\n各区域设施覆盖统计:")
print(coverage_df.describe())

print("\n前10个设施最丰富的区域:")
print(coverage_df.nlargest(10, 'total_facilities')[['region_name', 'total_facilities', 'bus_stops', 'parks', 'hospitals']])

print("\n前10个设施最缺乏的区域:")
print(coverage_df.nsmallest(10, 'total_facilities')[['region_name', 'total_facilities', 'bus_stops', 'parks', 'hospitals']])

# --- 6. 识别服务不足区域 ---
print("\n" + "=" * 60)
print("服务不足区域识别")
print("=" * 60)

underserved = coverage_df[
    (coverage_df['total_facilities'] < 3) | 
    (coverage_df['hospitals'] == 0) |
    (coverage_df['bus_stops'] == 0)
]

if not underserved.empty:
    print(f"✓ 识别出 {len(underserved)} 个服务不足的区域")
    print("\n服务不足区域详情:")
    display_cols = ['region_name', 'total_facilities', 'bus_stops', 'parks', 'hospitals']
    if 'total_population' in underserved.columns:
        display_cols.append('total_population')
    print(underserved[display_cols].to_string(index=False))
    
    print("\n" + "-" * 40)
    print("新增设施建议:")
    print("-" * 40)
    for _, row in underserved.iterrows():
        suggestions = []
        if row['bus_stops'] == 0:
            suggestions.append("🚌 增设巴士站")
        if row['parks'] == 0:
            suggestions.append("🌳 增设公园/休憩用地")
        if row['hospitals'] == 0:
            suggestions.append("🏥 增设诊所/医疗中心")
        if row['total_facilities'] < 3 and not suggestions:
            suggestions.append("🏪 增设社区综合设施")
        
        print(f"\n区域: {row['region_name']}")
        for s in suggestions:
            print(f"  • {s}")
else:
    print("✓ 所有区域设施覆盖良好")

# --- 7. 数据可视化 ---
print("\n" + "=" * 60)
print("生成可视化图表...")
print("=" * 60)

# 7.0 确保区域名称列存在
name_col = None
for col in ['region_name', 'dcca_chi', 'dcca_eng', 'dc_chi', 'ca_chi', 'name']:
    if col in boundary_gdf.columns:
        name_col = col
        break

if name_col is None:
    boundary_gdf['region_name'] = boundary_gdf.index.astype(str)
    name_col = 'region_name'
elif name_col != 'region_name':
    boundary_gdf['region_name'] = boundary_gdf[name_col]
    name_col = 'region_name'

if 'region_name' not in coverage_df.columns:
    for col in ['region_name', 'dcca_chi', 'dcca_eng', 'dc_chi', 'name']:
        if col in coverage_df.columns:
            coverage_df['region_name'] = coverage_df[col]
            break
    else:
        coverage_df['region_name'] = coverage_df.index.astype(str)

# 7.1 合并分析结果到地理数据
boundary_with_coverage = boundary_gdf.merge(
    coverage_df[['region_name', 'total_facilities', 'bus_stops', 'parks', 'hospitals']],
    on='region_name',
    how='left'
)

print(f"✓ 合并完成，边界数据: {len(boundary_with_coverage)} 个区域")

# 处理缺失值
if boundary_with_coverage['total_facilities'].isna().any():
    boundary_with_coverage['total_facilities'] = boundary_with_coverage['total_facilities'].fillna(0)
    boundary_with_coverage['bus_stops'] = boundary_with_coverage['bus_stops'].fillna(0)
    boundary_with_coverage['parks'] = boundary_with_coverage['parks'].fillna(0)
    boundary_with_coverage['hospitals'] = boundary_with_coverage['hospitals'].fillna(0)

# 标记服务不足区域
boundary_with_coverage['underserved'] = boundary_with_coverage['region_name'].isin(underserved['region_name'])

# 7.2 创建图表 
fig, axes = plt.subplots(2, 2, figsize=(16, 14))

# 图1: 设施总数分布（热力图）
ax1 = axes[0, 0]
if boundary_with_coverage['total_facilities'].notna().any() and boundary_with_coverage['total_facilities'].sum() > 0:
    boundary_with_coverage.plot(column='total_facilities', ax=ax1,
                                legend=True, cmap='YlOrRd',
                                legend_kwds={'label': '15分钟步行可达设施总数', 'shrink': 0.8},
                                edgecolor='black', linewidth=0.2)
    ax1.set_title('各区域15分钟生活圈设施覆盖总数', fontsize=14, fontweight='bold')
else:
    ax1.text(0.5, 0.5, '无设施数据', 
             horizontalalignment='center', verticalalignment='center',
             transform=ax1.transAxes, fontsize=16, color='red')
    ax1.set_title('各区域15分钟生活圈设施覆盖总数（数据缺失）', fontsize=14, fontweight='bold')
ax1.axis('off')

# 图2: 服务不足区域
ax2 = axes[0, 1]
if boundary_with_coverage['underserved'].any():
    boundary_with_coverage.plot(column='underserved', ax=ax2,
                                categorical=True, cmap='Set2',
                                legend=True, edgecolor='black', linewidth=0.2)
    ax2.set_title('服务不足区域识别', fontsize=14, fontweight='bold')
else:
    ax2.text(0.5, 0.5, '所有区域服务良好！', 
             horizontalalignment='center', verticalalignment='center',
             transform=ax2.transAxes, fontsize=16, color='green')
    ax2.set_title('服务不足区域识别（无服务不足区域）', fontsize=14, fontweight='bold')
ax2.axis('off')

# ==============================================================
# 图3: 各类设施分布柱状图 
# ==============================================================
ax3 = axes[1, 0]
top10 = coverage_df.nlargest(10, 'total_facilities')
x = np.arange(len(top10))
width = 0.25
ax3.bar(x - width, top10['bus_stops'], width, label='巴士站 (Bus)', color='#2E86AB')
ax3.bar(x, top10['parks'], width, label='公园 (Park)', color='#4CAF50')
ax3.bar(x + width, top10['hospitals'], width, label='医院 (Hospital)', color='#E74C3C')

# --- 添加轴标签 ---
ax3.set_xlabel('区域名称 (Region)', fontsize=12, fontweight='bold')
ax3.set_ylabel('设施数量 (Facility Count)', fontsize=12, fontweight='bold')
# --------------------------

ax3.set_title('设施最丰富的10个区域 (Top 10 Areas by Facilities)', fontsize=14, fontweight='bold')
ax3.set_xticks(x)
ax3.set_xticklabels(top10['region_name'], rotation=45, ha='right', fontsize=9)
ax3.legend()

# ==============================================================
# 图4: 设施缺乏区域统计
# ==============================================================
ax4 = axes[1, 1]
if not underserved.empty:
    bottom10 = coverage_df.nsmallest(10, 'total_facilities')
    x = np.arange(len(bottom10))
    width = 0.25
    ax4.bar(x - width, bottom10['bus_stops'], width, label='巴士站 (Bus)', color='#2E86AB')
    ax4.bar(x, bottom10['parks'], width, label='公园 (Park)', color='#4CAF50')
    ax4.bar(x + width, bottom10['hospitals'], width, label='医院 (Hospital)', color='#E74C3C')

    # --- 显式添加缺失的轴标签 ---
    ax4.set_xlabel('区域名称 (Region)', fontsize=12, fontweight='bold')
    ax4.set_ylabel('设施数量 (Facility Count)', fontsize=12, fontweight='bold')
    # --------------------------

    ax4.set_title('设施最缺乏的10个区域 (Bottom 10 Areas by Facilities)', fontsize=14, fontweight='bold')
    ax4.set_xticks(x)
    ax4.set_xticklabels(bottom10['region_name'], rotation=45, ha='right', fontsize=9)
    ax4.legend()
else:
    ax4.text(0.5, 0.5, '所有区域设施覆盖良好！', 
             horizontalalignment='center', verticalalignment='center',
             transform=ax4.transAxes, fontsize=16, color='green')

plt.tight_layout()

# ========== 显示并保存图表 ==========
plt.savefig('15min_living_circle_analysis.png', dpi=300, bbox_inches='tight')
print("✓ 图表已保存为 '15min_living_circle_analysis.png'")

# 在 jupyter 中显示（如果在命令行运行，此行会弹窗显示）
plt.show()
