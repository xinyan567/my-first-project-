# --- 8. 导出详细结果 ---
print("\n" + "=" * 60)
print("导出分析结果...")
print("=" * 60)

coverage_df.to_csv('coverage_analysis_detail.csv', index=False, encoding='utf-8-sig')
print("✓ 详细覆盖数据已导出为 'coverage_analysis_detail.csv'")

if not underserved.empty:
    underserved.to_csv('underserved_areas.csv', index=False, encoding='utf-8-sig')
    print("✓ 服务不足区域已导出为 'underserved_areas.csv'")

boundary_with_coverage.to_file('coverage_analysis_with_geometry.geojson', driver='GeoJSON')
print("✓ 带地理信息的分析结果已导出为 'coverage_analysis_with_geometry.geojson'")

print("\n" + "=" * 60)
print("分析完成！")
print("=" * 60)

# --- 9. 显示统计摘要 ---
print("\n统计摘要:")
print("-" * 40)
print(f"总分析区域数: {len(coverage_df)}")
print(f"总设施数: {len(facilities_gdf)}")
print(f"平均每区设施数: {coverage_df['total_facilities'].mean():.2f}")
print(f"设施覆盖区域: {len(coverage_df[coverage_df['total_facilities'] > 0])} 个")
print(f"设施盲区: {len(coverage_df[coverage_df['total_facilities'] == 0])} 个")
if 'facilities_per_1000' in coverage_df.columns:
    print(f"平均每千人设施数: {coverage_df['facilities_per_1000'].mean():.2f}")
